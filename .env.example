# Compose settings for both Linux and macOS. Copy to .env; never commit secrets.
# Backend model/API settings belong in backend/.env (copy backend/env.example).
# Use a random hexadecimal password on a NEW deployment; existing database
# volumes retain the password they were initialized with.
POSTGRES_PASSWORD=postgres
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
ADMINER_BIND_ADDRESS=127.0.0.1
ADMINER_PORT=8080

# Normally detected by scripts/compose.sh. Linux rootless example:
# AUTOCVE_DOCKER_SOCKET=/run/user/1000/docker.sock
# On macOS this is the VM's /var/run/docker.sock, not ~/.colima/.../docker.sock.

# Optional build networking. Defaults use public package registries directly.
# AUTOCVE_BUILD_HTTP_PROXY=http://host.docker.internal:7897
# AUTOCVE_BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# NPM_REGISTRY=https://registry.npmmirror.com

# Optional Pi/DinD runtime networking. Empty means no proxy; no DNS override.
# On Linux the proxy must listen on an address reachable from the Docker bridge.
# VERIFIER_HTTP_PROXY=http://host.docker.internal:7897
# VERIFIER_HTTPS_PROXY=http://host.docker.internal:7897
# VERIFIER_DNS=10.0.0.53
# VERIFIER_DNS_FALLBACK=10.0.0.54
# VERIFIER_REGISTRY_MIRROR=https://your-docker-mirror.example
